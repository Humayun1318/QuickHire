# ─────────────────────────────────────────────────────────────
# QuickHire API — environment variables
# Copy to .env for local development:  cp .env.example .env
# On Vercel, set these in Project Settings → Environment Variables
# (no .env file is used in production).
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Runtime ─────────────────────────────────────────────────────
# development | production | test   (required)
NODE_ENV=development
# Local server port (optional, default 5000; ignored on Vercel)
PORT=5000

# Database ────────────────────────────────────────────────────
# MongoDB connection string (required). Must be a replica set
# (MongoDB Atlas clusters are) because some writes use transactions.
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quickhire?retryWrites=true&w=majority

# CORS / frontend ─────────────────────────────────────────────
# Primary frontend origin (required) — used for CORS and OAuth redirects.
# No trailing slash.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma-separated (optional), e.g. a preview URL.
CORS_ORIGINS=

# Security ────────────────────────────────────────────────────
# bcrypt cost factor, integer 8–14 (required). 10–12 is typical.
BCRYPT_SALT_ROUND=10

# JWT (required). Use long random strings, different for each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES=7d

# Express "trust proxy" (optional). Leave empty: auto-set to 1 on Vercel,
# false elsewhere. Set to the number of proxies in front of the app if you
# host it behind another reverse proxy.
TRUST_PROXY=

# Super admin seed (required) ─────────────────────────────────
# Created automatically on first database connection if it does not exist.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=Change-Me-1!

# Google OAuth (optional) ─────────────────────────────────────
# Leave all three empty to disable Google sign-in (routes return 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=
