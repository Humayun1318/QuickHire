{
  "name": "quickhire-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "generateModule": "ts-node-dev --transpile-only scripts/generate-module.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.dev.json",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [],
  "author": "Humayun <humayunkabir6267@gmail.com> (https://github.com/Humayun1318)",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.15.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "colors": "^1.4.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.5.3",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "QuickHire — job portal REST API (Express 5, TypeScript, MongoDB)"
}
